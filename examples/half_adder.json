{
  "format": "logic-gates-simulator",
  "version": 1,
  "name": "Half Adder",
  "inputs": [
    "A",
    "B"
  ],
  "gates": {
    "XOR1": "XOR",
    "AND1": "AND"
  },
  "wires": [
    {
      "from": "A",
      "to_gate": "XOR1",
      "to_input": 0
    },
    {
      "from": "A",
      "to_gate": "AND1",
      "to_input": 0
    },
    {
      "from": "B",
      "to_gate": "XOR1",
      "to_input": 1
    },
    {
      "from": "B",
      "to_gate": "AND1",
      "to_input": 1
    }
  ],
  "outputs": {
    "Sum": "XOR1",
    "Carry": "AND1"
  }
}
